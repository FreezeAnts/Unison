<UserControl
    x:Class="Unison.Views.AddServicePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Unison.ViewModels">

    <StackPanel Spacing="12" MinWidth="440">
        <TextBlock Text="Search presets, then installed apps, websites, or the Store" Opacity="0.8" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                PlaceholderText="meet, chat, gmail, meet.google.com..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button
                Grid.Column="1"
                Margin="8,0,0,0"
                Content="Refresh"
                Click="Refresh_Click" />
        </Grid>

        <TextBlock
            Opacity="0.7"
            TextWrapping="Wrap"
            Text="Empty search lists catalog presets. Typing filters presets first (name, aliases, URL), then matching installed apps. Website guesses and Store search stay extra rows. Get app opens the Store; close this dialog and Refresh after install." />

        <ListView
            ItemsSource="{x:Bind ViewModel.Results, Mode=OneWay}"
            IsItemClickEnabled="True"
            ItemClick="Results_ItemClick"
            MaxHeight="280">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:CatalogItemViewModel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button
                            Grid.Column="1"
                            Tag="GetApp"
                            Content="Get app"
                            Padding="8,2"
                            Margin="8,0,0,0"
                            Visibility="{x:Bind GetAppVisibility}"
                            Click="GetAppButton_Click" />
                        <TextBlock
                            Grid.Column="2"
                            Text="{x:Bind KindLabel}"
                            Opacity="0.6"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Text="Or paste a website" Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBox
            Header="Name"
            PlaceholderText="Google Meet"
            Text="{x:Bind ViewModel.CustomName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBox
            Header="Address"
            PlaceholderText="https://meet.google.com"
            Text="{x:Bind ViewModel.CustomUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
            Text="{x:Bind ViewModel.CustomError, Mode=OneWay}"
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            TextWrapping="Wrap" />
        <Button Content="Add website" Click="AddCustomWebsite_Click" />
    </StackPanel>
</UserControl>
